{
  "name": "@rollout/ui-features",
  "description": "Feature-level React UI components built on @rollout/ui-kit",
  "author": "rollout",
  "license": "MIT",
  "version": "0.0.2",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@rollout/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.2.18",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint-plugin-storybook": "^10.2.18",
    "globals": "^17.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.2.18",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "keywords": [
    "rollout",
    "ui-features",
    "react",
    "components",
    "blocks",
    "typescript"
  ]
}
